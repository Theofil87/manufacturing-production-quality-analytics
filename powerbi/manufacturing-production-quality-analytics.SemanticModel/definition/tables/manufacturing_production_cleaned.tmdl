table manufacturing_production_cleaned
	lineageTag: b24a66b7-487f-423e-8fc3-078663e73252

	measure 'Total Production' =
			
			SUM(manufacturing_production_cleaned[production_quantity])
		formatString: 0
		lineageTag: 56b3599d-f88f-41c4-bddd-f0a23c7e0aad

	measure 'Total Defective Units' =
			
			SUM(manufacturing_production_cleaned[defective_units])
		formatString: 0
		lineageTag: fc36fd85-a05a-4523-b252-63bb711832e0

	measure 'Total Scrap Units' =
			
			SUM(manufacturing_production_cleaned[scrap_units])
		formatString: 0
		lineageTag: 4d5a6376-b5fe-4c13-87e3-2b5daaf438e5

	measure 'Total Downtime Minutes' =
			
			SUM(manufacturing_production_cleaned[downtime_minutes])
		formatString: 0
		lineageTag: 71d1ca9f-57e5-480c-89f0-489832f0db8d

	measure 'Defect Rate' =
			
			DIVIDE(
			    [Total Defective Units],
			    [Total Production]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4f2b5385-0b6d-43a5-805e-0b7a939fb0da

	measure 'Scrap Rate' =
			
			DIVIDE(
			    [Total Scrap Units],
			    [Total Production]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0aa0fb85-431c-4d25-9e7b-28d97c2216a2

	measure 'Yield Rate' =
			
			DIVIDE(
			    SUM(manufacturing_production_cleaned[good_units]),
			    [Total Production]
			)
		lineageTag: bcf7a894-a3f2-47cd-acbf-0f2132a88a64

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Reconciliation Gap' =
			
			[Total Production]
			    - SUM(manufacturing_production_cleaned[good_units])
			    - [Total Defective Units]
			    - [Total Scrap Units]
		formatString: 0
		lineageTag: ea0cec2b-0eac-4c97-8209-bbf02a274fc2

	measure 'Reconciliation Status' =
			
			IF(
			    [Reconciliation Gap] = 0,
			    "OK",
			    "Check Data"
			)
		lineageTag: 781c6075-340e-49c5-be4c-a04d3bf11fd8

