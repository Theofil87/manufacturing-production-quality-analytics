	partition manufacturing_production_cleaned = m
		mode: import
		source =
				let
				    Forrás = Csv.Document(File.Contents("C:\Users\Note\Documents\manufacturing-production-quality-analytics\data\processed\manufacturing_production_cleaned.csv"),[Delimiter=",", Columns=14, Encoding=1250, QuoteStyle=QuoteStyle.None]),
				    #"Előléptetett fejlécek" = Table.PromoteHeaders(Forrás, [PromoteAllScalars=true]),
				    #"Típus módosítva" = Table.TransformColumnTypes(#"Előléptetett fejlécek",{{"record_id", Int64.Type}, {"date", type date}, {"shift", type text}, {"production_line", type text}, {"product", type text}, {"production_quantity", Int64.Type}, {"defective_units", Int64.Type}, {"scrap_units", Int64.Type}, {"downtime_minutes", type text}, {"defect_category", type text}, {"downtime_reason", type text}, {"good_units", Int64.Type}, {"defect_rate", type text}, {"scrap_rate", type text}}),
				    #"Egyéni oszlop hozzáadva" = Table.AddColumn(#"Típus módosítva", "Shift Sort Order", each if [shift] = "Morning" then 1
				else if [shift] = "Afternoon" then 2
				else if [shift] = "Night" then 3
				else 99),
				    Egyéni1 = Table.TransformColumnTypes(
				    #"Egyéni oszlop hozzáadva",
				    {{"downtime_minutes", type number}},
				    "en-US"
				),
				    #"Egyéni oszlop hozzáadva1" = Table.AddColumn(Egyéni1, "downtime_reason_clean", each if [downtime_reason] = null then "No Reason Recorded"
				else if Text.Trim([downtime_reason]) = "" then "No Reason Recorded"
				else [downtime_reason]),
				    Egyéni2 = Table.TransformColumnTypes(
				    #"Egyéni oszlop hozzáadva1",
				    {
				        {"Shift Sort Order", Int64.Type},
				        {"downtime_reason_clean", type text}
				    }
				)
				in
				    Egyéni2

	annotation PBI_ResultType = Table

